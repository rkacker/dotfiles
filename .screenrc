# Disable the startup message
startup_message off

# Set a large scrollback buffer
defscrollback 32000

# Always start `screen` with UTF-8 enabled (`screen -U`)
defutf8 on

# Include display/caption
caption always "%{= Wk}%-w%{= Bw}%n %t%{-}%+w %-="

# change key binding to not conflict with emacs
escape ^tt

# Mouse scroll back in the buffer in a screen
# https://serverfault.com/questions/206303/how-to-scroll-back-in-screen-within-a-ssh-session-from-os-x
termcapinfo xterm* ti@:te@

# TODO: On startup create the following sessions
# screen -t "server" 1
# screen -t "logs" 2
# screen -t "ruby" 3
# screen -t "coffeescript" 4
